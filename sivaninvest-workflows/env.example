# Copy this to .env and fill in your values
# Then run: source .env && ./sivaninvest-workflows/setup.sh

# Airtable Personal Access Token
# Get yours at: https://airtable.com/create/tokens
# Required scopes: data.records:read, data.records:write
AIRTABLE_API_KEY=patXXXXXXXXXXXXXX

# n8n instance URL (default: http://localhost:5678)
N8N_HOST=http://localhost:5678

# n8n API key (only needed for auto-patching credential IDs)
# Settings → API → Create API key
N8N_API_KEY=
